//! 3 4 1 0 # 1\n1
//! 3 2 0 0 # 0\n0

fn start () {
    var x = X{ a = readI32(), b = readI32() };
    writeI32(x == X{ a=3, b=4 } ? 1 : 0);

    var y = readI32() > 0 ? Y.a(readI32()) : Y.b(readI32());
    writeI32(y == Y.a(0) ? 1 : 0);
}

struct X {
    a: I32,
    b: I32
}

enum Y {
    a(I32),
    b(I32)
}
