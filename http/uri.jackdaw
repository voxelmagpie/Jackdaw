// Returns false if the uri includes "." or ".." file names, or is empty, or doesn't start with "/"
// Assumes that the string only contains ascii characters
// TODO AsciiString (null terminated, msb always 0)
fn uriIsValid (uri: String): Bool {
    if uri.length() > 4000 { return false; }
    var uriLen = uri.utf8Slice().length() as I32;
    if uriLen < 1 or uri.utf8Slice().at(0) != '/' { return false; }

    var i = 1;
    loop {
        if i >= uriLen { break; }
        var fileNameLen = 0;
        for (; i+fileNameLen < uriLen and uri.utf8Slice().at(i+fileNameLen) != '/'; fileNameLen+=1) {}
        if fileNameLen == 1 and uri.utf8Slice().at(i) == '.' { return false; }
        if fileNameLen == 2 and uri.utf8Slice().at(i) == '.' and uri.utf8Slice().at(i+1) == '.' { return false; }
        i += fileNameLen;
        if i >= uriLen { break; }
        i += 1; // Skip '/'
    }

    return true;
}

fn isUriSafeChar (c: U8): Bool {
    return 
        (c >= 'a' and c <= 'z') or
        (c >= 'A' and c <= 'Z') or
        (c >= '0' and c <= '9') or
        c == '$' or c == '-' or
        c == '_' or
        c == '.' or
        c == '*' or
        c == '/';
}
