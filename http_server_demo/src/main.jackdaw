import "@stlib/network"
import "@stlib/process"
import "@stlib/raw_slice"
import "@stlib/io"
import "@stlib/fs"
import "@stlib/posix"
import "@stlib/os_string"
import "@http/http"
import "@http/uri"

fn start (Args, var streams: IoStreams) {
    // var server = ListenSocket.openOn(25565);
    // streams.stdOut.writeLine("Listening");

    var (server, port) = ListenSocket.open();
    streams.stdOut.writeLine("Listening on port " ++ port.toString());

    
    
    loop {
        var s = server.acceptUnbuffered();
        match Process.fork() {
            .parent(_) {
                // The child process now has a copy of the socket so this (parent) process's copy of 
                // the socket is closed
            }
            .child {
                handleConn(s);
            }
        }
    }
}

fn handleConn (var unbuf: UnbufferedSocket): I32 {
    var s = Socket.fromUnbuffered(unbuf);

    loop {
        if !s.peekByte().isSome() { return 0; }

        var .{ reqType, uri, keepAliveDefault:keepAlive } = HttpRequest.read(s).orThrow();

        var headers = readHttpHeaders(s).orThrow();
        if headers.contains("connection") {
            keepAlive = headers.get("connection") != "close";
        }

        trace(uri);

        // for x in headers.iterEntries() { // TODO destructuring of for-each loop value
        //     trace(x.0 ++ ": " ++ x.1);
        // }

        if !uriIsValid(uri) { 
            s.writeString(response400);
            continue;
        }

        var filePath = OsString.fromString(uri == "/" ? rootFilePath ++ "/index.html" : rootFilePath ++ uri);
        var fileLength: I64;
        match getFileSize(filePath) {
            .size(x) { 
                fileLength = x; 
            }
            .notAFile {
                if uri == "/" {
                    s.writeString(response404Root);
                }
                else {
                    s.writeString(response404);
                }
                continue;
            }
            .notFound {
                s.writeString(response400);
                continue;
            }
        }

        if uri == "/" {
            s.writeString(responseHeadHtml);
        }
        else {
            s.writeString(responseHead);
        }

        var flStr = fileLength.toString();
        s.writeString(flStr);
        s.writeString("\r\n\r\n");

        match reqType {
            .head {
            }
            .get {
                if fileLength > 0 {
                    var m = MMapFile.new(filePath, 0, fileLength);
                    s.writeBytes(m.asSlice());
                }
            }
        }

        if !keepAlive { break; }
    }

    return 0;
}

fn loadGoogle (ref streams: IoStreams) {
    var s = Socket.connect("www.google.com", 80);
    s.writeString(requestGoogle);
    loop {
        match s.readByte() {
            .some(c) { 
                streams.stdOut.writeByte(c);
            }
            _ { break; }
        }
    }
}

const responseHead: String = "HTTP/1.1 200 OK\r\nContent-Length: "
const responseHeadHtml: String = "HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: "
const responseFile: String = "hello\r\n"
const response404: String = "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n"
const response404Root: String = "HTTP/1.1 404 Not Found\r\nContent-Length: 31\r\n\r\nMissing index.html in /var/www/"
const response400: String = "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n"
const response403: String = "HTTP/1.1 403 Forbidden\r\nContent-Length: 0\r\n\r\n"
const rootFilePath: String = "/var/www"

const requestGoogle: String = "GET / HTTP/1.1\r\nHost: www.google.com\r\n\r\n"
