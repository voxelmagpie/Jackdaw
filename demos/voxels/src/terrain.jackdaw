import "@stlib/range"
import "block"
import "noise"

struct Terrain {
    blocks: List[BlockType]

    fn generate (seed: F32): Self {
        var blocks = List[BlockType].new();
        blocks.reserve(8*32*32);
        foreach i in range[I32](0, 8*32*32) {
            blocks.push(.air);
        }

        var self = Self{blocks};
        var noise = makeNoise2(seed);

        var i = 0;
        for (var j=0; j < 32*32; i=i+1, j=j+1) { self.blocks.at(i) = noise.at(j) > 50 ? .sand: .soil; }
        for (var j=0; j < 32*32; i=i+1, j=j+1) { self.blocks.at(i) = noise.at(j) > 90 ? .sand : .water; }
        for (var j=0; j < 32*32; i=i+1, j=j+1) { if noise.at(j) > 110 {self.blocks.at(i) = .sand;} }
        for (var j=0; j < 32*32; i=i+1, j=j+1) { if noise.at(j) > 140 {self.blocks.at(i) = noise.at(j) > 150 ? .grass : .sand;} }
        for (var j=0; j < 32*32; i=i+1, j=j+1) { if noise.at(j) > 160 {self.blocks.at(i) = .grass;} }
        for (var j=0; j < 32*32; i=i+1, j=j+1) { if noise.at(j) > 200 {self.blocks.at(i) = .grass;} }
        for (var j=0; j < 32*32; i=i+1, j=j+1) { if noise.at(j) > 220 {self.blocks.at(i) = .grass;} }
        for (var j=0; j < 32*32; i=i+1, j=j+1) { if noise.at(j) > 250 {self.blocks.at(i) = .grass;} }


        return self;
    }

    accessor at (self: Self, x: I32, y: I32, z: I32): BlockType {
        return self.blocks.at(y*32*32 + x*32 + z);
    }
}

fn faceVisible (thisBlock: BlockType, otherBlock: BlockType): Bool {
    return (otherBlock == .air or otherBlock == .water) and thisBlock != otherBlock;
}

alias VPos = Array[I8, 4]
alias VNorm = Array[I8, 4]
alias VCol = Array[U8, 4]

// Returns list of positions, list of normals, list of colours
fn makeTerrainMesh (t: Terrain, waterPass: Bool): (List[VPos], List[VNorm], List[VCol]) {
    var positions = List[VPos].new();
    var normals = List[VNorm].new();
    var colours = List[VCol].new();

    foreach y in range[I8](0, 8) {
        foreach x in range[I8](0, 32) {
            foreach z in range[I8](0, 32) {
                var block = t.at(x, y, z);
                if block == .air or (block == .water) != waterPass { continue; }

                var colour: VCol;
                match block {
                    .air {
                        colour = [0,0,0,0];
                    }
                    .stone {
                        colour = [120,120,120, 255];
                    }
                    .soil {
                        colour = [138, 93, 43, 255];
                    }
                    .grass {
                        colour = [64, 184, 106, 255];
                    }
                    .sand {
                        colour = [235, 234, 176, 255];
                    }
                    .water {
                        colour = [99, 136, 255, 127];
                    }
                }


                // TOP
                if y == 7 or faceVisible(block, t.at(x, y+1, z)) {
                    positions.push([x, y+1, z, 1]);
                    positions.push([x, y+1, z+1, 1]);
                    positions.push([x+1, y+1, z+1, 1]);
                    positions.push([x+1, y+1, z+1, 1]);
                    positions.push([x+1, y+1, z, 1]);
                    positions.push([x, y+1, z, 1]);
                    foreach i in range[I8](0, 6) {
                        normals.push([0, 1, 0, 0]);
                        colours.push(colour);
                    }
                }

                // // BOTTOM
                // if y == 0 or faceVisible(block, t.at(x, y-1, z)) {
                //     positions.push([x, y+1, z, 1]);
                //     positions.push([x+1, y+1, z, 1]);
                //     positions.push([x+1, y+1, z+1, 1]);
                //     positions.push([x+1, y+1, z+1, 1]);
                //     positions.push([x, y+1, z+1, 1]);
                //     positions.push([x, y+1, z, 1]);
                //     foreach i in range[I8](0, 6) {
                //         normals.push([0, -1, 0, 0]);
                //         colours.push(colour);
                //     }
                // }

                // RIGHT
                if x == 31 or faceVisible(block, t.at(x+1, y, z)) {
                    positions.push([x+1, y, z, 1]);
                    positions.push([x+1, y+1, z, 1]);
                    positions.push([x+1, y+1, z+1, 1]);
                    positions.push([x+1, y+1, z+1, 1]);
                    positions.push([x+1, y, z+1, 1]);
                    positions.push([x+1, y, z, 1]);
                    foreach i in range[I8](0, 6) {
                        normals.push([1, 0, 0, 0]);
                        colours.push(colour);
                    }
                }

                // LEFT
                if x == 0 or faceVisible(block, t.at(x-1, y, z)) {
                    positions.push([x, y, z, 1]);
                    positions.push([x, y, z+1, 1]);
                    positions.push([x, y+1, z+1, 1]);
                    positions.push([x, y+1, z+1, 1]);
                    positions.push([x, y+1, z, 1]);
                    positions.push([x, y, z, 1]);
                    foreach i in range[I8](0, 6) {
                        normals.push([1, 0, 0, 0]);
                        colours.push(colour);
                    }
                }

                // +Z
                if z == 31 or faceVisible(block, t.at(x, y, z+1)) {
                    positions.push([x, y, z+1, 1]);
                    positions.push([x+1, y, z+1, 1]);
                    positions.push([x+1, y+1, z+1, 1]);
                    positions.push([x+1, y+1, z+1, 1]);
                    positions.push([x, y+1, z+1, 1]);
                    positions.push([x, y, z+1, 1]);
                    foreach i in range[I8](0, 6) {
                        normals.push([0, 0, 1, 0]);
                        colours.push(colour);
                    }
                }

                // -Z
                if z == 0 or faceVisible(block, t.at(x, y, z-1)) {
                    positions.push([x, y, z, 1]);
                    positions.push([x, y+1, z, 1]);
                    positions.push([x+1, y+1, z, 1]);
                    positions.push([x+1, y+1, z, 1]);
                    positions.push([x+1, y, z, 1]);
                    positions.push([x, y, z, 1]);
                    foreach i in range[I8](0, 6) {
                        normals.push([0, 0, -1, 0]);
                        colours.push(colour);
                    }
                }
            }
        }
    }

    return (positions, normals, colours);
}
