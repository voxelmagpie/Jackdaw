@Unsafe
fn __errno_location (): *I32

fn getErrNo (): I32 unsafe {
    return __errno_location().*;
}

@Unsafe
fn strerror (errnum: I32): *CChar

@NoReturn
fn ioError (wh: String) unsafe {
    var e = getErrNo();
    var s = "IO error in " ++ wh ++ ": ";
    s.appendCString(strerror(e));
    s ++= " (errno " ++ e.toString() ++ ")";
    trace(s);
    throw &"IO Error";
}
