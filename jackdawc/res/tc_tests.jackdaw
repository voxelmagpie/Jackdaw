// Iterator dependency loops

iterator f (): I32 {
    foreach x in g() {
        yield x;
    }
}

iterator g (): I32 {
    foreach x in h() {
        yield x;
    }
}

iterator h (): I32 {
    foreach x in f() {
        yield x;
    }
}

fn start () {}

