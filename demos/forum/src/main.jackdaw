import "@stlib/network"
import "@stlib/raw_slice"
import "@stlib/io"
import "@stlib/fs"
import "@stlib/posix"
import "@stlib/os_string"
import "@http/http"
import "@http/server" (Server, Connection, Request)
import "@http/uri"
import "@http/form" (parseFormData)
import "db"

struct Statements {
    getPosts: StatementId,
    insertPost: StatementId

    fn create (ref db: Db): Self {
        return .{
            getPosts = db.prepareStatement(&"SELECT * FROM Posts"),
            insertPost = db.prepareStatement(&"INSERT INTO Posts (text) VALUES (?)")
        };
    }
}

fn start (Args, var streams: IoStreams) {
    dbInit();

    var user = readTextFile("user");
    user.trimEnd();
    var pw = readTextFile("pw");
    pw.trimEnd();

    // Test connection & queries
    _ = Statements.create(Db.connect(user, pw));

    var server = Server.new(25566);
    streams.stdOut.writeLine("Listening on port " ++ server.server.port.toString());
    loop {
        match server.acceptFork() {
            .none {}
            .some(conn) {
                var db = Db.connect(user, pw);
                var statements = Statements.create(db);
                loop {
                    match conn.nextRequest() {
                        .closed { break; }
                        .request(r) {
                            var closeAfter = !r.keepAlive;
                            handleReq(conn, db, statements, r);
                            if closeAfter { break; }
                        }
                    }
                }
            }
        }
    }
}

fn filterHtml (src: String): Maybe[String] {
    var dst = List[U8].new();
    borrow src = src.utf8Slice();
    var i: ISize = 0;

    loop {
        // Get any number of unescaped characters
        var j: ISize = 0;
        loop {
            if i+j >= src.length() { break; }
            var c = src.at(i+j);
            if c == '<' or c == '>' or c == '&' or c == '"' or c == '\'' {
                break;
            }
            else {
                j += 1;
            }
        }
        if i == 0 and j == src.length() { return .none; } // No characters to escape
        dst ++= src.subSlice(i, j);
        i += j;

        // Escape character

        if i >= src.length() { break; }
        var x = src.at(i);
        i += 1;

        if x == '<' {
            dst ++= "&lt;".utf8Slice();
        }
        else if x == '>' {
            dst ++= "&gt;".utf8Slice();
        }
        else if x == '&' {
            dst ++= "&amp;".utf8Slice();
        }
        else if x == '"' {
            dst ++= "&quot;".utf8Slice();
        }
        else {
            dst ++= "&apos;".utf8Slice();
        }
    }

    return .some(String.fromByteListUnchecked(dst));
}

fn handleReq (ref conn: Connection, ref db: Db, ref statements: Statements, var req: Request) {
    var .{ head, reqType, uri, keepAlive:_, headers:reqHeaders, body } = req;
    // trace(uri);


    // TODO Better way of creating empty slices
    var respHeaders = List[(String, String)].new();

    if uri == "/" {
        match reqType {
            .head {}
            .get {}
            .post { conn.sendBadRequest400(); return; }
        }

        var template = readTextFile("res/templates/main_page.html");

        var html: String;
        var html2: String;
        {
            var i: ISize = 0;
            foreach x in template.utf8Slice().iter() {
                if x == '`' {
                    break;
                }
                else {
                    i += 1;
                }
            }
            html = template.subString(0, i);
            html2 = template.subString(i+1, template.length() - i - 1);
        }

        var emptySqlParams = List[DbValue].new();
        db.stmt(statements.getPosts).query(emptySqlParams.asSlice());
        foreach fields in db.stmt(statements.getPosts).iterRows() {
            html ++= "<div class=\"post_outer\"><div class =\"post_inner\">";
            match fields.at(1) {
                .some(.string(s)) {
                    match filterHtml(s) {
                        .some(s2) { html ++= s2; }
                        .none { html ++= s; }
                    }
                }
                _ { throw &"DB schema error"; }
            }
            html ++= "</div></div>";
        }
        html ++= html2;
        conn.sendString(html, respHeaders.asSlice(), head);
    }
    else if uri == "/add_post" {
        match reqType {
            .post {}
            _ { conn.sendBadRequest400(); return; }
        }

        if !reqHeaders.contains("content-type") or reqHeaders.get("content-type") != "application/x-www-form-urlencoded" {
            conn.sendBadRequest400(); return; 
        }

        var formData = parseFormData(body).orThrow();
        foreach (k, v) in formData.iter() {
            if k == "text" {
                var values = Array[DbValue, 1].singleton(.string(v.clone()));
                db.stmt(statements.insertPost).execute(values.asSlice());
                conn.sendRedirect303("/");
                return;   
            }
        }

        conn.sendBadRequest400();
    }
    else {
        match reqType {
            .head {}
            .get {}
            .post { conn.sendBadRequest400(); return; }
        }

        var path = OsString.fromString("res/static" ++ uri);
        conn.sendFile(path, respHeaders.asSlice(), head);
    }
}
