import "@stlib/utf8"
import "@stlib/raw_slice"

// A string with an unknown encoding used for file paths and command line arguments
struct OsString {
    @Unsafe 
    data: List[U8] // Null terminated, encoding will be UTF-16 on Windows and is ASCII-compatible on Linux

    fn fromString (var s: String): Self unsafe {
        // This will need to convert to UTF-16 when Windows support is added
        var {utf8Data} = s;
        return Self{ data = utf8Data };
    }

    fn removeNullTerminator (ref self: Self) unsafe {
        _ = self.data.pop();
        if const targetWin32 { _ = self.data.pop(); }
    }

    fn addNullTerminator (ref self: Self) unsafe {
        self.data.push(0);
        if const targetWin32 { self.data.push(0); }
    }
    
    fn append ++= (ref self: Self, other: OsString) unsafe {
        self.removeNullTerminator();
        self.data.append(other.data.asSlice());
    }

    fn appendPathSep (ref self: Self) unsafe {
        self.removeNullTerminator();
        self.data.push('/');
        if const targetWin32 { self.data.push(0); }
        self.addNullTerminator();
    }

    @Unsafe
    fn getCPtr (self: Self): *CChar {
        return self.data.ptr as *CChar;
    }

    fn isValidUtf8 (self: Self): Bool {
        return isValidUtf8(self.utf8Slice());
    }

    fn toStringMv (var self: Self): String unsafe {
        if !self.isValidUtf8() {
             throw &"Invalid unicode in OsString"; }
        var {data} = self;
        return String{ utf8Data=data };
    }

    @Unsafe
    fn getUtf8RawSliceWithNull (self: Self): RawSlice[U8] {
        return self.data.asRawSlice();
    }

    @Unsafe
    fn getUtf8RawSliceNoNull (self: Self): RawSlice[U8] {
        var x = self.data.asRawSlice(); 
        x.length -= 1;
        return x;
    }

    accessor utf8Slice (self: Self): Slice[U8] unsafe {
        return self.getUtf8RawSliceNoNull();
    } 
}
