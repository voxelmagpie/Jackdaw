import "@stlib/json" (*)

fn encodeJson (j: Json, rootId: JsonObjectId): String {
    var s = String.new();
    encodeObject(s, j, rootId);
    return s;
}

fn encodeObject (ref s: String, j: Json, id: JsonObjectId) {
    // TODO Operator overloading, have ++= work with U8 (ASCII) and I32 (UTF)
    s.pushAsciiChar('{');
    var empty = true;
    foreach field in j.objects.get(id).iterEntries() {
        empty = false;
        encodeString_(s, j, field.0);
        s.pushAsciiChar(':');
        s.pushAsciiChar(' ');
        encodeValue(s, j, field.1);
        s.pushAsciiChar(',');
        s.pushAsciiChar(' ');
    }
    if !empty { unsafe {s.utf8Data.removeLastN(3); s.utf8Data.push(0); } }
    s.pushAsciiChar('}');
}

fn encodeArray (ref s: String, j: Json, id: JsonArrayId) {
    s.pushAsciiChar('[');
    var empty = true;
    foreach value in j.arrays.get(id).iter() {
        empty = false;
        encodeValue(s, j, value);
        s.pushAsciiChar(',');
        s.pushAsciiChar(' ');
    }
    if !empty { unsafe {s.utf8Data.removeLastN(3); s.utf8Data.push(0); } }
    s.pushAsciiChar(']');
}

fn encodeValue (ref s: String, j: Json, value: JsonValue) {
    match value {
        .object(id) {
            encodeObject(s, j, id);
        }
        .array(id) {
            encodeArray(s, j, id);
        }
        .string(id) {
            encodeString(s, j, id);
        }
        .number(x) {
            s ++= x.toString();
        }
        .bool(x) {
            if x { s ++= "true"; } else { s ++= "false"; }
        }
        .null {
            s ++= "null";
        }
    }
}

fn encodeString (ref s: String, j: Json, id: JsonStringId) {
    encodeString_(s, j, j.strings.get(id));
}

fn encodeString_ (ref s: String, j: Json, str: String) {
    s.pushAsciiChar('"');
    foreach c in str.utf8Slice().iter() {
        if c == 0 {
            s.pushAsciiChar('\\'); s.pushAsciiChar('0');
        }
        else if c == '"' {
            s.pushAsciiChar('\\'); s.pushAsciiChar('"');
        }
        else if c == '\\' {
            s.pushAsciiChar('\\'); s.pushAsciiChar('\\');
        }
        else if c == '\b' {
            s.pushAsciiChar('\\'); s.pushAsciiChar('b');
        }
        else if c == '\f' {
            s.pushAsciiChar('\\'); s.pushAsciiChar('f');
        }
        else if c == '\n' {
            s.pushAsciiChar('\\'); s.pushAsciiChar('n');
        }
        else if c == '\r' {
            s.pushAsciiChar('\\'); s.pushAsciiChar('r');
        }
        else if c == '\t' {
            s.pushAsciiChar('\\'); s.pushAsciiChar('t');
        }
        else {
            s.pushAsciiChar(c);
        }
    }
    s.pushAsciiChar('"');
}
