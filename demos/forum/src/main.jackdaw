import "@stlib/network"
import "@stlib/raw_slice"
import "@stlib/io"
import "@stlib/fs"
import "@stlib/posix"
import "@stlib/os_string"
import "@stlib/hash_map"
import "@stlib/template"
import "@http/http"
import "@http/server" (Server, Connection, Request)
import "@http/uri"
import "@http/form" (parseFormData)
import "db"

struct Statements {
    getPosts: StatementId,
    getPostsCount: StatementId,
    insertPost: StatementId

    fn create (ref db: Db): Self {
        return .{
            getPosts = db.prepareStatement(&"SELECT id, text FROM Posts ORDER BY id ASC LIMIT 10 OFFSET ?"),
            getPostsCount = db.prepareStatement(&"SELECT COUNT(*) FROM Posts"),
            insertPost = db.prepareStatement(&"INSERT INTO Posts (text) VALUES (?)")
        };
    }
}

fn start (Args, var streams: IoStreams) {
    dbInit();

    var user = readTextFile("user");
    user.trimEnd();
    var pw = readTextFile("pw");
    pw.trimEnd();

    // Test connection & queries
    _ = Statements.create(Db.connect(user, pw));

    var server = Server.new(8080);
    streams.stdOut.writeLine("Listening on port " ++ server.server.port.toString());
    loop {
        // var conn = server.accept();
        match server.acceptFork() {
            .none {}
            .some(conn) {
                var db = Db.connect(user, pw);
                var statements = Statements.create(db);
                loop {
                    match conn.nextRequest() {
                        .closed { break; }
                        .request(r) {
                            var closeAfter = !r.keepAlive;
                            handleReq(conn, db, statements, r);
                            if closeAfter { break; }
                        }
                    }
                }
            }
        }
    }
}

fn filterHtml (src: String): Maybe[String] {
    var dst = List[U8].new();
    borrow src = src.utf8Slice();
    var i: ISize = 0;

    loop {
        // Get any number of unescaped characters
        var j: ISize = 0;
        loop {
            if i+j >= src.length() { break; }
            var c = src.at(i+j);
            if c == '<' or c == '>' or c == '&' or c == '"' or c == '\'' {
                break;
            }
            else {
                j += 1;
            }
        }
        if i == 0 and j == src.length() { return .none; } // No characters to escape
        dst ++= src.subSlice(i, j);
        i += j;

        // Escape character

        if i >= src.length() { break; }
        var x = src.at(i);
        i += 1;

        if x == '<' {
            dst ++= "&lt;".utf8Slice();
        }
        else if x == '>' {
            dst ++= "&gt;".utf8Slice();
        }
        else if x == '&' {
            dst ++= "&amp;".utf8Slice();
        }
        else if x == '"' {
            dst ++= "&quot;".utf8Slice();
        }
        else {
            dst ++= "&apos;".utf8Slice();
        }
    }

    return .some(String.fromByteListUnchecked(dst));
}

fn handleReq (ref conn: Connection, ref db: Db, ref statements: Statements, var req: Request) {
    var .{ head, reqType, uri, keepAlive:_, headers:reqHeaders, queryParameters, body } = req;
    // trace(uri);


    // TODO Better way of creating empty slices
    var respHeaders = List[(String, String)].new();

    if uri == "/" {
        // Only allow get/head
        match reqType {
            .head {}
            .get {}
            .post { conn.sendMethodNotAllowed405(); return; }
        }

        // Get total number of posts in database

        var sqlParams = List[DbValue].new();
        var schemaErr = &"DB schema error";

        var totalPostsCount: I64 = 0;
        {
            sqlParams.clear();
            db.stmt(statements.getPostsCount).query(sqlParams.asSlice());
            var row = db.stmt(statements.getPostsCount).nextRow().orThrow();
            match row.at(0) {
                .some(.bigInt(x)) { totalPostsCount = x; } 
                _ { throw schemaErr; }
            }
        }
        var pageCount = (totalPostsCount + 9) / 10; // Rounds up

        // Query parameters

        var pageNumber: I64 = 1;
        foreach (k, v) in queryParameters.iter() {
            if k == "page" {
                match v.parseInt() {
                    .some(x) { pageNumber = clamp[I64](x, 1, pageCount); }
                    _ { conn.sendBadRequest400(); return; }
                }
            }
            else if k == "latest" {
                pageNumber = pageCount;
            }
            else {
                conn.sendBadRequest400();
                return;
            }
        }

        // Get posts

        sqlParams.clear();
        sqlParams.push(.bigInt((pageNumber-1) * 10));
        db.stmt(statements.getPosts).query(sqlParams.asSlice());
        var posts = db.stmt(statements.getPosts).getAllRows();

        // Generate HTML

        var template = readTextFile("res/templates/main_page.html");
        var addPostForm = readTextFile("res/templates/add_post_form.html");

        var postsHtml = String.new();
        foreach fields in posts.iter() {
            postsHtml ++= "<div class=\"post_outer\"><div class =\"post_inner\">";
            match fields.at(1) {
                .some(.string(s)) {
                    match filterHtml(s) {
                        .some(s2) { postsHtml ++= s2; }
                        .none { postsHtml ++= s; }
                    }
                }
                _ { throw schemaErr; }
            }
            postsHtml ++= "</div></div>";
        }
        
        var vars = HashMap[String, String].new();
        vars.insert("posts".clone(), postsHtml);
        vars.insert("pageCount".clone(), pageCount.toString());
        vars.insert("pageNumber".clone(), pageNumber.toString());
        
        if pageNumber == pageCount {
            vars.insert("addPostFormMaybe".clone(), addPostForm);
        }

        if pageNumber == 1 {
            vars.insert("prevDisabled".clone(), "disabled".clone());
        }
        else {
            vars.insert("prevPage".clone(), (pageNumber-1).toString());
        }

        if pageNumber == pageCount {
            vars.insert("nextDisabled".clone(), "disabled".clone());
        }
        else {
            vars.insert("nextPage".clone(), (pageNumber+1).toString());
        }

        var html = substitute(template, vars, true);

        conn.sendString(html, respHeaders.asSlice(), head);
    }
    else if uri == "/add_post" {
        match reqType {
            .post {}
            _ { conn.sendBadRequest400(); return; }
        }

        if !reqHeaders.contains("content-type") or reqHeaders.get("content-type") != "application/x-www-form-urlencoded" {
            conn.sendBadRequest400(); return; 
        }

        var formData = parseFormData(body).orThrow();
        foreach (k, v) in formData.iter() {
            if k == "text" {
                if v.length() < 1 or v.length() > 65535 { break; }
                // TODO Better way of creating slice from variable/reference
                var values = Array[DbValue, 1].singleton(.string(v.clone()));
                _ = db.stmt(statements.insertPost).execute(values.asSlice());
                conn.sendRedirect303("/?latest");
                return;   
            }
        }

        conn.sendBadRequest400();
    }
    else {
        match reqType {
            .head {}
            .get {}
            .post { conn.sendBadRequest400(); return; }
        }

        var path = OsString.fromString("res/static" ++ uri);
        conn.sendFile(path, respHeaders.asSlice(), head);
    }
}
