//! 3 1 # 4
//! -3 1 # -3
//! 3 0 # 3

accessor f (a: (I32, I32)): I32 {
    if a.0 > 0 {
        return a.0;
    }
    return a.1;
}

accessor g (a: (I32, I32)): I32 {
    if a.0 <= 0 {
        return a.0;
    }
    return a.1;
}


fn start() {
    var x = (readI32(), 3 as I32);
    var a = readI32() > 0 ? f : g;
    a(x) = a(x) + 1;
    writeI32(x.0);
}