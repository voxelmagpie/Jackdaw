enum X { A(I32), B(I32) }

fn start () {
    var x = X.A(0);
    match ref x {
        A(i) { x = X.B(0); }
        _ {}
    }
}

// --- //

enum X { A(I32), B(I32) fn onDrop (Self) {} }

fn start () {
    var x = X.A(0);
    match var x {
        A(i) { x = X.B(0); }
        _ {}
    }
}

// --- //

enum X { A(I32), B(I32) }

fn start () {
    var x = X.A(0);
    var y: I32;
    match var x {
        A(_) { y = 0; }
        _ {}
    }
}

