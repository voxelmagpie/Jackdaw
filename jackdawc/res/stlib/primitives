type Array [A, n] {
	fn new (x: A): Self unsafe {
		require typeIsCopyable[A];
		var xs: Self = uninitialised;
		foreach ref y in xs.iter() {
			(&y).* = x;
		}
		return xs;
	}

	fn singleton (var x: A): Self unsafe {
		require n == 1;
		var xs: Self = uninitialised;
		(&xs as *A).* = x;
		return xs;
	}

	accessor at (self: Self, i: ISize): A unsafe {
		if i < 0 or i >= n { throw &"Array index out of bounds"; }
		return (&self as *A) + i;
	}

	accessor iterator iter (self: Self): A {
		for (var i: ISize = 0; i < n; i+=1) {
			yield self.at(i);
		}
	}

	// Takes exclusive reference to guarantee that the ref is passed as a pointer
	// TODO
	@Unsafe
	fn asRawSlice (ref self: Self): RawSlice[A] {
		return RawSlice[A]{ ptr = &self as *A, length=n };
	}

	accessor asSlice (self: Self): Slice[A] unsafe {
		return RawSlice[A]{ ptr = &self as *A, length=n };
	}
}

type Slice [A] {
	@Unsafe
	fn asRawSlice (self: Self): RawSlice[A]

	accessor at (self: Self, i: ISize): A unsafe {
		return self.asRawSlice().atPtr(i);
	}

	fn length (self: Self): ISize unsafe {
		return self.asRawSlice().length;
	}

    accessor subSlice (self: Self, i: ISize, n: ISize): Self unsafe {
		return self.asRawSlice().subSlice(i, n);
	}

	accessor iterator iter (self: Self): A {
		var l = self.length();
		for (var i: ISize = 0; i < l; i=i+1) {
			yield self.at(i);
		}
	}

	accessor one (x: A): Self unsafe {
		return RawSlice[A]{ ptr = &x, length=1 };
	}
}

