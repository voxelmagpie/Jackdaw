//! 8 8 # 1
//! 3 4 # 0
//! 3 5 # 0\n-2
//! -1 -2 # 0\n-1

fn start () {
    writeI32(g(readI32()).isSome() ? 1 : 0);
    match g2(readI32()) {
        .ok{}
        .err(x) { writeI32(x); }
    }
}

fn g (x: I32): Maybe[I32] {
    var xIsErr = f(x);
    xIsErr!;
    return x % 2 == 0 ? .some(x) : .none;
}

fn f (x: I32): IsError {
    return x >= 0 ? .ok : .err;
}


fn g2 (x: I32): MaybeError[I32] {
    var xIsErr = f2(x);
    xIsErr!;
    if x % 2 == 0 {
        return .ok;
    }
    else {
        return .err(-2);
    }
}

fn f2 (x: I32): MaybeError[I32] {
    if x >= 0 {
        return .ok;
    }
    else {
        return .err(-1);
    }
}
