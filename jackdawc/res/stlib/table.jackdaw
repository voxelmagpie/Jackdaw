import "@stlib/hash_map"

struct Table [Id, A] {
    data: HashMap[Id, A],
    nextId: I32

    fn new (): Self {
        return .{ data = .new(), nextId = 0 };
    }

    fn insert (ref self: Self, var x: A): Id {
        // TODO newtypes
        var id = Id{ x = self.nextId };
        self.data.insert(id, x);
        self.nextId += 1;
        return id;
    }

    fn take (ref self: Self, id: Id): A {
        return self.data.take(id);
    }

    accessor get (self: Self, id: Id): A {
        return self.data.get(id);
    }
} 