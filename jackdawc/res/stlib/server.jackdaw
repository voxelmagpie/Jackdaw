import "@stlib/network"
import "@stlib/process"
import "@stlib/thread"

struct Server {
    socket: ListenSocket,
    port: U16

    fn new (var port: U16): Self {
        var socket: ListenSocket;
        if port == 0 {
            var (s,p) = ListenSocket.open();
            socket = s;
            port = p;
        }
        else {
            socket = .openOn(port);
        }

        return Self{ socket, port };
    }

    fn accept (ref self: Self): UnbufferedSocket {
        return self.socket.acceptUnbuffered();
    }

    // If .none is returned then the caller is in the original process and should call acceptFork again
    fn acceptFork (ref self: Self): Maybe[UnbufferedSocket] {
        var s = self.socket.acceptUnbuffered();
        match Process.fork() {
            .parent(_) {
                // The child process now has a copy of the socket so this (parent) process's copy of 
                // the socket is closed
                return .none;
            }
            .child {
                return .some(s);
            }
        }
    }

    fn acceptThreaded [T] (ref self: Self, f: fn (var UnbufferedSocket, var T), var x: T) {
        var s = self.socket.acceptUnbuffered();
        Thread[(fn (var UnbufferedSocket, var T), UnbufferedSocket, T), I32].new(Self._run[T], (f, s, x), 0).leak();
    }

    fn _run [T] (var x: (fn (var UnbufferedSocket, var T), UnbufferedSocket, T)): I32 {
        var (x,y,z) = x;
        x(y, z);
        return 0;
    }
}


