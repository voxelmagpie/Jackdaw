//! 4 5 -8 # 18
//! -3 5 0 # 2
//! 3 -5 -8 #  

fn start () {
    var r = g(readI32(), readI32());
    match r {
        .ok(x) { writeI32(x); }
        _ {}
    }

    match h(readI32()) {
        .some(x) { writeI32(x); }
        _ {}
    }
}

fn g (x: I32, y: I32): Result[I32, *const String] {
    var x = f(x)!;
    var y = f(y)!;
    return .ok(x+y);
}

fn f (x: I32): Result[I32, *const String] {
    if x < 0 { return .err(&"Value too small"); }
    return .ok(x*2);
}


fn h (var x: I32): Maybe[I32] {
    x = hh(x+1)!;
    return hh(x+1);
}

fn hh (x: I32): Maybe[I32] {
    return x > 0 ? .some(x) : .none;
}