import "@stlib/table"
import "@stlib/hash_map"
import "@stlib/json_encode"
import "@stlib/json_parse"

// TODO newtypes
struct JsonObjectId { x: I32 }
struct JsonArrayId { x: I32 }
struct JsonStringId { x: I32 }

struct Json {
    objects: Table[JsonObjectId, HashMap[String, JsonValue]],
    arrays: Table[JsonArrayId, List[JsonValue]],
    strings: Table[JsonStringId, String]

    fn new (): Self {
        return .{
            objects = .new(),
            arrays = .new(), 
            strings = .new()
        };
    }

    fn encode (self: Self, rootId: JsonObjectId): String {
        return encodeJson(self, rootId);
    }

    fn parse (s: String): JsonResult[(Self, JsonObjectId)] {
        var i: ISize = 0;
        return parseJson(s, i); 
    }
}

enum JsonValue {
    Object  (JsonObjectId),
    Array   (JsonArrayId),
    String  (JsonStringId),
    Number  (F64),
    Bool    (Bool),
    Null
}

alias JsonResult [A] = Result[A, *const String]
alias JsonMaybeError = MaybeError[*const String]


