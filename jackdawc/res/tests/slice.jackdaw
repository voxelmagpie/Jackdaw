//! # 4\n4

fn sum (s: Slice[I32]): I32 {
    var x = 0;
    for (var i: ISize = 0; i < s.length(); i += 1) {
        x += s.at(i);
    }
    return x;
}

fn start () {
    var x = [1, 1, 2];
    writeI32(sum(x.asSlice()));

    var x = List[I32].new();
    x.push(1);
    x.push(2);
    x.push(1);
    writeI32(sum(x.asSlice()));
}
