import "@stlib/range" (*)

@Unsafe
struct RawSlice [A] {
    @Unsafe ptr: *A,
    @Unsafe length: ISize

    @Unsafe
    fn empty (): Self {
        return .{ ptr=nullptr, length=0 };
    }

    @Unsafe
    accessor at (self: Self, i: ISize): A {
        return self.atPtr(i);
    }

    @Unsafe
    fn atPtr (self: Self, i: ISize): *A {
        if i < 0 or i >= self.length { throw &"Index out of range"; }
        return &self.ptr.(i);
    }

    @Unsafe
    fn subSlice (self: Self, var i: ISize, var n: ISize): Self {
        putRangeInBounds(self.length, i, n);
        return Self{ ptr = &self.ptr.(i), length = n };
    }

    @Unsafe
    iterator iter (self: Self): *A {
        for (var i: ISize = 0; i < self.length; i += 1) {
            yield &self.ptr.(i);
        }
    }
}


