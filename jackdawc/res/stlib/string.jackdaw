import "hash"
import "utf8"
import "raw_slice"
import "range"
import "memory" as M ()

@Unsafe @NoThrow fn strtoll (str: *CChar, str_end: **CChar, base: I32): I64

struct String {
    @Unsafe 
    utf8Data: List[U8] // Null terminated

    fn new (): Self unsafe {
        return Self{ utf8Data = .singleton(0) };
    }

    fn hash (self: Self): Hash unsafe {
        return hashBytes(self.utf8Data.asSlice());
    }

    fn ++= appendString (ref self: Self, other: String) unsafe {
        _ = self.utf8Data.pop();
        self.utf8Data.append(other.utf8Data.asSlice());
    }

    fn fromByteList (var utf8Data: List[U8]): Maybe[Self] unsafe {
        var l = utf8Data.length();
        var isNullTerminated = l > 0 and utf8Data.at(l - 1) == 0;
        if isNullTerminated {
            if !isValidUtf8(utf8Data.asSlice().subSlice(0, l-1)) { return .none; }
            return .some(.{utf8Data});
        }
        else {
            if !isValidUtf8(utf8Data.asSlice()) { return .none; }
            utf8Data.push(0);
            return .some(.{utf8Data});
        }
    }

    fn fromByteListUnchecked (var utf8Data: List[U8]): Self unsafe {
        var l = utf8Data.length();
        var isNullTerminated = l > 0 and utf8Data.at(l - 1) == 0;
        if !isNullTerminated {
            utf8Data.push(0);
        }
        return .{utf8Data};
    }

    @Unsafe
    fn appendCString (ref self: Self, c: *CChar) {
        var sl = RawSlice[U8]{ ptr = c as *U8, length = strlen(c) as ISize };
        if !isValidUtf8(sl) { throw &"C string is not valid UTF-8"; }
        sl.length += 1; // Add null terminator back
        _ = self.utf8Data.pop();
        self.utf8Data ++= sl;
    }

    @Unsafe
    fn appendCStringUnchecked (ref self: Self, c: *CChar) {
        var sl = RawSlice[U8]{ ptr = c as *U8, length = strlen(c) as ISize };
        sl.length += 1; // Add null terminator back
        _ = self.utf8Data.pop();
        self.utf8Data ++= sl;
    }

    fn appendUtf8 (ref self: Self, xs: Slice[U8]) unsafe {
        if !isValidUtf8(xs) { throw &"Byte slice is not valid UTF-8"; }
        self.appendUtf8Unchecked(xs);
    }

    fn appendUtf8Unchecked (ref self: Self, xs: Slice[U8]) unsafe {
        _ = self.utf8Data.pop();
        self.utf8Data ++= xs;
        self.utf8Data.push(0);
    }

    fn append (ref self: Self, x: String) {
        self.appendUtf8Unchecked(x.utf8Slice());
    }

    @Unsafe
    fn copyFromCString (c: *CChar): Self {
        var sl = RawSlice[U8]{ ptr = c as *U8, length = strlen(c) as ISize };
        if !isValidUtf8(sl) { throw &"C string is not valid UTF-8"; }
        sl.length += 1; // Add null terminator back
        var utf8Data = List[U8].new();
        utf8Data ++= sl;
        return .{utf8Data};
    }

    fn ++ join (self: Self, other: String): String unsafe {
        var utf8Data = List[U8].new();
        utf8Data.reserve(self.utf8Data.length() + other.utf8Data.length() - 1);
        utf8Data.append(self.utf8Data.asSlice());
        _ = utf8Data.pop();
        utf8Data.append(other.utf8Data.asSlice());
        return Self{utf8Data};
    }

    fn pushAsciiChar (ref self: Self, c: U8) unsafe {
        if c == 0 or c > 127 { throw &"ASCII character out of range"; }
        self.utf8Data.at(self.utf8Data.length()-1) = c;
        self.utf8Data.push(0);
    }

    // TODO Test this properly
    fn pushCodePoint (ref self: Self, c: U32) unsafe {
        _ = self.utf8Data.pop();
        if c == 0 {
            self.pushCodePoint(0xfffd);
        }
        else if c <= 0x7f {
            self.utf8Data.push(c as U8);
        }
        else if c <= 0x7ff {
            self.utf8Data.push((((c >> 6) & 0b11111) | 0b11000000) as U8);
            self.utf8Data.push(((c & 0b111111) | 0b10000000) as U8);
        }
        else if c >= 0xD800 and c <= 0xDFFF {
            throw &"Surrogate values are not valid UTF8";
        }
        else if c <= 0xffff {
            self.utf8Data.push((((c >> 12) & 0b1111) | 0b11100000) as U8);
            self.utf8Data.push((((c >> 6) & 0b111111) | 0b10000000) as U8);
            self.utf8Data.push(((c & 0b111111) | 0b10000000) as U8);
        }
        else if c <= 0x10FFFF {
            self.utf8Data.push((((c >> 18) & 0b111) | 0b11110000) as U8);
            self.utf8Data.push((((c >> 12) & 0b111111) | 0b10000000) as U8);
            self.utf8Data.push((((c >> 6) & 0b111111) | 0b10000000) as U8);
            self.utf8Data.push(((c & 0b111111) | 0b10000000) as U8);
        }
        else {
            throw &"Unicode code point out of range";
        }
        self.utf8Data.push(0);
    }

    // Includes null terminator
    fn sizeInBytes (self: Self): ISize unsafe {
        return self.utf8Data.length();
    }

    // The length in bytes, *not* counting the null terminator byte
    fn length (self: Self): ISize unsafe {
        return self.utf8Data.length() - 1;
    }

    @Unsafe
    fn getCPtr (self: Self): *CChar {
        return self.utf8Data.ptr as *CChar;
    }

    @Unsafe
    fn getUtf8RawSliceWithNull (self: Self): RawSlice[U8] {
        return self.utf8Data.asRawSlice();
    }

    @Unsafe
    fn getUtf8RawSliceNoNull (self: Self): RawSlice[U8] {
        var x = self.utf8Data.asRawSlice(); 
        x.length -= 1;
        return x;
    }

    accessor utf8Slice (self: Self): Slice[U8] unsafe {
        return self.getUtf8RawSliceNoNull();
    } 

    // Only handles ASCII space characters for now
    fn trimEnd (ref self: Self) unsafe {
        var atEnd: ISize = 0;
        for (var i: ISize = self.utf8Data.length()-2; i >= 0; i -= 1) {
            var c = self.utf8Data.at(i);
            if c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 11  or c == 12 { 
                atEnd += 1; 
            } else { 
                break; 
            }
        }

        if atEnd > 0 {
            self.utf8Data.removeLastN(atEnd);
            self.utf8Data.at(self.utf8Data.length()-1) = 0;
        }
    }

    fn addToString (self: Self, ref s: String) {
        s.pushAsciiChar('"');
        s ++= self;
        s.pushAsciiChar('"');
    }

    iterator iterCodePoints (self: Self): U32 {
        var i: ISize = 0;
        loop {
            if i >= self.length() { break; }
            var (cp, j) = self.codePointAt(i);
            yield cp;
            i += j;
        }   
    }

    fn findStartOfCodePoint (self: Self, var i: ISize): ISize unsafe {
        if i < 0 or i >= self.utf8Data.length()-1 { throw &"Index out of range"; }
        
        loop {
            if (self.utf8Data.at(i) >> 6) == 0b10 {
                i -= 1;
                if i <= 0 { i = 0; break; }
            }
            else {
                break;
            }
        }

        return i;
    }

    // Returns (code point, utf8 bytes length)
    fn codePointAt (self: Self, var i: ISize): (U32, I32) unsafe {
        i = self.findStartOfCodePoint(i);

        match readUtf8CodePoint(self.utf8Data.asSlice().subSlice(i, self.utf8Data.length()-1-i)) {
            .none { throw &"Invalid UTF8"; }
            .some(x) { return x; }
        }
    }

    fn reserve (ref self: Self, n: ISize) unsafe {
        self.utf8Data.reserve(n+1);
    }

    fn startsWith (ref self: Self, prefix: String): Bool unsafe {
        if prefix.utf8Data.length() > self.utf8Data.length() {
            return false;
        }

        return M.compare[U8](self.utf8Data.ptr, prefix.utf8Data.ptr, prefix.utf8Data.length() - 1) == 0;
    }

    fn subString (self: Self, var i: ISize, var n: ISize): String unsafe {
        putRangeInBounds(self.length(), i, n);

        for (; self.utf8Data.at(i) >> 6 == 0b10;) {
            // Continuation byte
            i += 1;
            n -= 1;
            if n < 1 { return String.new(); }
        }
        
        if self.utf8Data.at(i+n-1) >> 6 == 0b10 {
            // Continuation byte
            var continuationBytes = 0;
            for (; self.utf8Data.at(i+n-1-continuationBytes) >> 6 == 0b10; continuationBytes += 1) {}
            var c0 = self.utf8Data.at(i+n-1-continuationBytes);
            var n: I32;
            if c0 >> 5 == 0b110 {
                n = 1;
            }
            else if c0 >> 4 == 0b1110 {
                n = 2;
            }
            else if c0 >> 3 == 0b11110 {
                n = 3;
            }
            else { throw &""; }
            if n != continuationBytes {
                n -= continuationBytes + 1;
                if n < 1 { return String.new(); }
            }
        }
        
        var utf8Data = List[U8].new();
        utf8Data.reserve(n+1);
        utf8Data.append(self.utf8Data.asSlice().subSlice(i, n));
        utf8Data.push(0);

        return .{utf8Data};
    }

    fn parseInt (self: String): Maybe[I64] unsafe {
        var end: *I8;
        var x = strtoll(self.getCPtr(), &end, 10);
        if end == self.getCPtr() {
            return .none;
        }
        return .some(x);
    }
}
