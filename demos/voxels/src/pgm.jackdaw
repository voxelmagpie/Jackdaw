import "@stlib/os_string"
import "@stlib/fs"

fn writePgm (filePath: OsString, img: List[U8], width: I32, height: I32) {
    assert(img.length() == width*height);

    var f = File.open(filePath, true);
    f.writeString("P5\n");
    f.writeString(width.toString());
    f.writeString(" ");
    f.writeString(height.toString());
    f.writeString("\n255\n");
    f.writeBytes(img.asSlice());
}
