import "@stlib/memory" as M (*)

@Unsafe struct MYSQL { dummy: I8 }
@Unsafe struct MYSQL_RES { dummy: I8 }
@Unsafe struct MYSQL_STMT { dummy: I8 }
@Unsafe alias MYSQL_ROW = **I8

union RowPtrOrIndicator {
	row_ptr(*U8),
	indicator(*I8)
}

@Unsafe const _MYSQL_DATA_TRUNCATED: I32 = 101
@Unsafe const _MYSQL_NO_DATA: I32 = 100

alias EnumFieldTypes = I32
@Unsafe const _MYSQL_TYPE_DECIMAL: EnumFieldTypes = 0
@Unsafe const _MYSQL_TYPE_TINY: EnumFieldTypes = 1
@Unsafe const _MYSQL_TYPE_SHORT: EnumFieldTypes = 2
@Unsafe const _MYSQL_TYPE_LONG: EnumFieldTypes = 3
@Unsafe const _MYSQL_TYPE_FLOAT: EnumFieldTypes = 4
@Unsafe const _MYSQL_TYPE_DOUBLE: EnumFieldTypes = 5
@Unsafe const _MYSQL_TYPE_NULL: EnumFieldTypes = 6
@Unsafe const _MYSQL_TYPE_TIMESTAMP: EnumFieldTypes = 7
@Unsafe const _MYSQL_TYPE_LONGLONG: EnumFieldTypes = 8
@Unsafe const _MYSQL_TYPE_INT24: EnumFieldTypes = 9
@Unsafe const _MYSQL_TYPE_DATE: EnumFieldTypes = 10
@Unsafe const _MYSQL_TYPE_TIME: EnumFieldTypes = 11
@Unsafe const _MYSQL_TYPE_DATETIME: EnumFieldTypes = 12
@Unsafe const _MYSQL_TYPE_YEAR: EnumFieldTypes = 13
@Unsafe const _MYSQL_TYPE_NEWDATE: EnumFieldTypes = 14
@Unsafe const _MYSQL_TYPE_VARCHAR: EnumFieldTypes = 15
@Unsafe const _MYSQL_TYPE_BIT: EnumFieldTypes = 16
@Unsafe const _MYSQL_TYPE_TIMESTAMP2: EnumFieldTypes = 17
@Unsafe const _MYSQL_TYPE_DATETIME2: EnumFieldTypes = 18
@Unsafe const _MYSQL_TYPE_TIME2: EnumFieldTypes = 19
@Unsafe const _MYSQL_TYPE_JSON: EnumFieldTypes = 245
@Unsafe const _MYSQL_TYPE_NEWDECIMAL: EnumFieldTypes = 246
@Unsafe const _MYSQL_TYPE_ENUM: EnumFieldTypes = 247
@Unsafe const _MYSQL_TYPE_SET: EnumFieldTypes = 248
@Unsafe const _MYSQL_TYPE_TINY_BLOB: EnumFieldTypes = 249
@Unsafe const _MYSQL_TYPE_MEDIUM_BLOB: EnumFieldTypes = 250
@Unsafe const _MYSQL_TYPE_LONG_BLOB: EnumFieldTypes = 251
@Unsafe const _MYSQL_TYPE_BLOB: EnumFieldTypes = 252
@Unsafe const _MYSQL_TYPE_VAR_STRING: EnumFieldTypes = 253
@Unsafe const _MYSQL_TYPE_STRING: EnumFieldTypes = 254
@Unsafe const _MYSQL_TYPE_GEOMETRY: EnumFieldTypes = 255
@Unsafe const _MAX_NO_FIELD_TYPES: EnumFieldTypes = 256

@Unsafe
struct MYSQL_BIND {
	length: *CULong,
	is_null: *I8,
	buffer: *void,
	error: *I8,
	u: RowPtrOrIndicator,
	store_param_func: *void,
	fetch_result: *void,
	skip_result: *void,
	buffer_length: CULong,
	offset: CULong,
	length_value: CULong,
	flags: U32,
	pack_length: U32,
	buffer_type: EnumFieldTypes,
	error_value: I8,
	is_unsigned: I8,
	long_data_used: I8,
	is_null_value: I8,
	extension: *void
}

@Unsafe
struct MYSQL_FIELD {
	name: *I8,
	org_name: *I8,
	table: *I8,
	org_table: *I8,
	db: *I8,
	catalog: *I8,
	def: *I8,
	length: CULong,
	max_length: CULong,
	name_length: U32,
	org_name_length: U32,
	table_length: U32,
	org_table_length: U32,
	db_length: U32,
	catalog_length: U32,
	def_length: U32,
	flags: U32,
	decimals: U32,
	charsetnr: U32,
	_type: EnumFieldTypes,
	extension: *void
}

@Unsafe @NoThrow fn mysql_server_init()
@Unsafe @NoThrow fn mysql_init (mysql: *MYSQL): *MYSQL
@Unsafe @NoThrow fn mysql_real_connect (mysql: *MYSQL, host: *I8, user: *I8, passwd: *I8, db: *I8, port: U32, unix_socket: *I8, clientflag: CULong): *MYSQL
@Unsafe @NoThrow fn mysql_error (mysql: *MYSQL): *I8
@Unsafe @NoThrow fn mysql_real_query (mysql: *MYSQL, q: *I8, length: CULong): I32
@Unsafe @NoThrow fn mysql_store_result (mysql: *MYSQL): *MYSQL_RES
@Unsafe @NoThrow fn mysql_num_fields (res: *MYSQL_RES): U32
@Unsafe @NoThrow fn mysql_fetch_row (result: *MYSQL_RES): MYSQL_ROW
@Unsafe @NoThrow fn mysql_free_result (result: *MYSQL_RES)
@Unsafe @NoThrow fn mysql_close (sock: *MYSQL)
@Unsafe @NoThrow fn mysql_stmt_init (mysql: *MYSQL): *MYSQL_STMT
@Unsafe @NoThrow fn mysql_stmt_close (stmt: *MYSQL_STMT): I8
@Unsafe @NoThrow fn mysql_stmt_prepare (stmt: *MYSQL_STMT, query: *I8, length: CULong): I32
@Unsafe @NoThrow fn mysql_stmt_param_count (stmt: *MYSQL_STMT): CULong
@Unsafe @NoThrow fn mysql_stmt_bind_param (stmt: *MYSQL_STMT, bnd: *MYSQL_BIND): I8
@Unsafe @NoThrow fn mysql_stmt_execute (stmt: *MYSQL_STMT): I32
@Unsafe @NoThrow fn mysql_stmt_affected_rows (stmt: *MYSQL_STMT): USize
@Unsafe @NoThrow fn mysql_stmt_insert_id (stmt: *MYSQL_STMT): USize
@Unsafe @NoThrow fn mysql_stmt_result_metadata (stmt: *MYSQL_STMT): *MYSQL_RES
@Unsafe @NoThrow fn mysql_stmt_bind_result (stmt: *MYSQL_STMT, bnd: *MYSQL_BIND): I8
@Unsafe @NoThrow fn mysql_fetch_fields (res: *MYSQL_RES): *MYSQL_FIELD
@Unsafe @NoThrow fn mysql_stmt_store_result (stmt: *MYSQL_STMT): I32
@Unsafe @NoThrow fn mysql_stmt_fetch (stmt: *MYSQL_STMT): I32
@Unsafe @NoThrow fn mysql_stmt_fetch_column (stmt: *MYSQL_STMT, bind_arg: *MYSQL_BIND, column: U32, offset: CULong): I32
@Unsafe @NoThrow fn mysql_stmt_error (stmt: *MYSQL_STMT): *I8

fn dbInit () unsafe {
    mysql_server_init();
}

enum DbValue {
    int(I32),
    bigInt(I64),
    string(String)
}

struct StatementId { x: I32 }

struct DbExecResult {
    affectedRows: USize,
    insertId: USize
}

struct Db {
    @Unsafe con: *MYSQL,
    @Unsafe stmts: List[Statement]

    fn connect (user: String, pw: String): Self unsafe {
        var con = mysql_init(nullptr);
        if con == nullptr { throw &"mysql_init error"; }

        if (mysql_real_connect(con, nullptr, user.getCPtr(), pw.getCPtr(), "forum".getCPtr(), 0, nullptr, 0) == nullptr) {
            traceCStr(mysql_error(con));
            throw &"mysql_real_connect error";
        }  

        return .{ con, stmts = .new() };
    }

    fn onDrop (ref self: Self) unsafe {
        mysql_close(self.con);
    }

    fn select (ref self: Self, query: *const String): QueryResultString unsafe {
        if (mysql_real_query(self.con, query.*.getCPtr(), query.*.length() as CULong) != 0) {
            traceCStr(mysql_error(self.con));
            throw &"mysql_real_query error";
        }

        var result = mysql_store_result(self.con);
        if result == nullptr { 
            traceCStr(mysql_error(self.con));
            throw &"mysql_store_result error"; 
        }

        var numFields = mysql_num_fields(result) as I32;

        return .{ result, numFields };
    }

    fn prepareStatement (ref self: Self, query: *const String): StatementId unsafe {
        var stmt = mysql_stmt_init(self.con);
        if stmt == nullptr { 
            traceCStr(mysql_error(self.con));
            throw &"mysql_stmt_init error"; 
        }

        if mysql_stmt_prepare(stmt, query.*.getCPtr(), query.*.length() as CULong) != 0 {
            traceCStr(mysql_error(self.con));
            throw &"mysql_stmt_prepare error"; 
        }

        var paramCount = mysql_stmt_param_count(stmt) as ISize;

        self.stmts.push(.{
            con = self.con,
            stmt,
            paramCount,
            binds = .newWithCapacity(paramCount),
            lengths = .newWithCapacity(paramCount),
            resultBinds = .new(),
            resultLengths = .new(),
            resultIsNulls = .new(),
            partialResults = .new()
        });
        return .{ x = self.stmts.length() as I32 - 1 };
    }

    accessor stmt (ref self: Self, id: StatementId): Statement unsafe {
        return self.stmts.at(id.x);
    }
}

struct Statement {
    @Unsafe con: *MYSQL,
    @Unsafe stmt: *MYSQL_STMT,

    @Unsafe paramCount: ISize,
    @Unsafe binds: List[MYSQL_BIND],
    @Unsafe lengths: List[USize],

    @Unsafe resultBinds: List[MYSQL_BIND],
    @Unsafe resultLengths: List[USize],
    @Unsafe resultIsNulls: List[I8],

    // Values for integers but not strings
    @Unsafe partialResults: List[DbValue]

    fn onDrop (ref self: Self) unsafe {
        if mysql_stmt_close(self.stmt) != 0 {
            traceCStr(mysql_error(self.con));
        }
    }

    fn _bindParams (ref self: Self, params: Slice[DbValue]) unsafe {
        if params.length() != self.paramCount {
            throw &"Wrong number of parameters for prepared statement";
        }

        if self.paramCount == 0 {
            return;
        }

        self.binds.clear();
        self.lengths.clear();

        foreach p in params.iter() {
            var b: MYSQL_BIND;
            M.set[U8](&b as *U8, 0, sizeOf[MYSQL_BIND]);

            match p {
                .int(x) {
                    b.buffer_type = _MYSQL_TYPE_LONG; 
                    b.buffer = &x;
                    b.buffer_length = 4;
                }
                .bigInt(x) {
                    b.buffer_type = _MYSQL_TYPE_LONGLONG; 
                    b.buffer = &x;
                    b.buffer_length = 8;
                }
                .string(s) {
                    b.buffer_type = _MYSQL_TYPE_STRING; 
                    b.buffer = s.getCPtr();
                    b.buffer_length = s.length() as USize;
                    // The length has to be specified twice for non-primitives and this one is a pointer
                    // The list won't reallocate as the size was reserved in prepareStatement so this is safe
                    self.lengths.push(s.length() as USize);
                    b.length = &self.lengths.at(self.lengths.length()-1);
                }
            }
            self.binds.push(b);
        }

        if mysql_stmt_bind_param(self.stmt, &self.binds.at(0)) != 0 {
            traceCStr(mysql_error(self.con));
            throw &"mysql_stmt_bind_param error";
        }
    }

    fn execute (ref self: Self, params: Slice[DbValue]): DbExecResult unsafe {
        self._bindParams(params);

        if mysql_stmt_execute(self.stmt) != 0 {
            traceCStr(mysql_error(self.con));
            throw &"mysql_stmt_execute error";
        }

        return .{
            affectedRows = mysql_stmt_affected_rows(self.stmt),
            insertId = mysql_stmt_insert_id(self.stmt)
        };
    }

    fn query (ref self: Self, params: Slice[DbValue]) unsafe {
        // Run query

        self._bindParams(params);

        if mysql_stmt_execute(self.stmt) != 0 {
            traceCStr(mysql_stmt_error(self.stmt));
            throw &"mysql_stmt_execute error";
        }

        // Get metadata

        var metadata = mysql_stmt_result_metadata(self.stmt);
        if metadata == nullptr {
            throw &"Query does not return data";
        }

        self.partialResults.clear();
        var fieldsCount = mysql_num_fields(metadata) as I32;
        var fields = mysql_fetch_fields(metadata);

        // Create results list to store integer results into
        for (var i = 0; i < fieldsCount; i += 1) {
            var f = &fields.(i);
            if f.*._type == _MYSQL_TYPE_LONG {
                self.partialResults.push(.int(0));
            }
            else if f.*._type == _MYSQL_TYPE_LONGLONG {
                self.partialResults.push(.bigInt(0));
            }
            else if f.*._type == _MYSQL_TYPE_BLOB {
                if f.*.charsetnr == 63 {
                    throw &"TODO: Blob";
                }
                // This String value is never used
                self.partialResults.push(.string(.new()));
            }
            else {
                trace("Field type: " ++ f.*._type.toString());
                throw &"Unknown field type";
            }
        }
        mysql_free_result(metadata);

        // Bind result buffers

        self.resultBinds.clear();
        self.resultBinds.reserve(fieldsCount);
        self.resultLengths.clear();
        self.resultLengths.reserve(fieldsCount);
        self.resultIsNulls.clear();
        self.resultIsNulls.reserve(fieldsCount);

        for (var i: ISize = 0; i < fieldsCount; i += 1) {
            var b: MYSQL_BIND;
            M.set[U8](&b as *U8, 0, sizeOf[MYSQL_BIND]);

            self.resultLengths.push(0);
            b.length = &self.resultLengths.at(self.resultLengths.length() - 1);
            self.resultIsNulls.push(0);
            b.is_null = &self.resultIsNulls.at(self.resultIsNulls.length() - 1);

            match ref self.partialResults.at(i) {
                .int(x) {
                    b.buffer_type = _MYSQL_TYPE_LONG;
                    b.buffer = &x;
                    b.buffer_length = 4;
                }
                .bigInt(x) {
                    b.buffer_type = _MYSQL_TYPE_LONGLONG;
                    b.buffer = &x;
                    b.buffer_length = 8;
                }
                .string(_) {
                    b.buffer_type = _MYSQL_TYPE_BLOB;
                    // Don't load strings, only get the lengths
                }
            }

            self.resultBinds.push(b);
        }

        if mysql_stmt_bind_result(self.stmt, &self.resultBinds.at(0)) != 0 {
            traceCStr(mysql_stmt_error(self.stmt));
            throw &"mysql_stmt_bind_result error";
        }

        // Preload data from db server

        if mysql_stmt_store_result(self.stmt) != 0 { 
            traceCStr(mysql_stmt_error(self.stmt));
            throw &"mysql_store_result error"; 
        }
    }

    fn nextRow (ref self: Self): Maybe[List[Maybe[DbValue]]] unsafe {
        if self.partialResults.length() == 0 { return .none; }

        var err = mysql_stmt_fetch(self.stmt);
        if err == _MYSQL_NO_DATA {
            self.partialResults.clear();
            return .none;
        }
        else if err != 0 and err != _MYSQL_DATA_TRUNCATED {
            traceCStr(mysql_stmt_error(self.stmt));
            throw &"mysql_stmt_fetch error"; 
        }

        var results = List[Maybe[DbValue]].new();
        results.reserve(self.partialResults.length());

        for (var i: ISize = 0; i < self.partialResults.length(); i += 1) {
            if self.resultIsNulls.at(i) != 0 {
                results.push(.none);
                continue;
            }

            match self.partialResults.at(i) {
                .int(x) {
                    results.push(.some(.int(x)));
                }
                .bigInt(x) {
                    results.push(.some(.bigInt(x)));
                }
                .string(_) {
                    var l = self.resultLengths.at(i);
                    if l > 65535 { throw &"String too large"; }
                    var l = l as ISize;
                    var bytes = List[U8]{ ptr = M.alloc[U8](l+1), _length=l+1, capacity=l+1 };
                    var b: MYSQL_BIND;
                    M.set[U8](&b as *U8, 0, sizeOf[MYSQL_BIND]);
                    b.buffer_type = _MYSQL_TYPE_BLOB;
                    b.buffer = bytes.getPtr();
                    b.buffer_length = l as CULong;
                    if mysql_stmt_fetch_column(self.stmt, &b, i as U32, 0) != 0 {
                        traceCStr(mysql_stmt_error(self.stmt));
                        throw &"mysql_stmt_fetch_column error"; 
                    }
                    bytes.at(l) = 0;
                    var s = String.fromByteList(bytes).orThrowMsg(&"Text is not valid UTF8");
                    results.push(.some(.string(s)));
                }
            }
        }
        return .some(results);
    }

    iterator iterRows (ref self: Self): List[Maybe[DbValue]] {
        loop {
            match self.nextRow() {
                .none { break; }
                .some(x) {
                    yield x;
                }
            }
        }
    }

    fn getAllRows (ref self: Self): List[List[Maybe[DbValue]]] {
        var xs = List[List[Maybe[DbValue]]].new();
        foreach x in self.iterRows() {
            xs.push(x);
        }
        return xs;
    }
}


struct QueryResultString {
    @Unsafe
    result: *MYSQL_RES,

    @Unsafe
    numFields: I32

    fn nextRow (ref self: Self): Maybe[List[String]] unsafe {
        var row = mysql_fetch_row(self.result);
        if row == nullptr { return .none; }

        var strings = List[String].new();
        for (var i = 0; i < self.numFields; i += 1) {
            var f = row.(i);
            if f == nullptr {
                strings.push(.new());
            }
            else {
                strings.push(String.copyFromCString(f));
            }
        }

        return .some(strings);
    }

    iterator iterRows (ref self: Self): List[String] {
        loop {
            match self.nextRow() {
                .none { break; }
                .some(x) { yield x; }
            }
        }
    }

    fn getAllRows (ref self: Self): List[List[String]] {
        var xs = List[List[String]].new();
        foreach x in self.iterRows() {
            xs.push(x);
        }
        return xs;
    }

    fn onDrop (ref self: Self) unsafe {
        mysql_free_result(self.result);
    }
}

@Unsafe
fn _extractField [T] (ref val: Maybe[DbValue], dst: *T): IsError {
    // TODO Maybe[I32/I64/String]
    if const typesEq[T, I32] {
        match ref val {
            .some(.int(x)) { dst.* = (&x).*; }
            _ { return .err; }
        }
    }
    else if const typesEq[T, I64] {
        match ref val {
            .some(.bigInt(x)) { dst.* = (&x).*; }
            .some(.int(x)) { dst.* = (&x).*; }
            _ { return .err; }
        }
    }
    else if const typesEq[T, String] {
        match ref val {
            .some(.string(x)) { dst.* = (&x).*; }
            _ { return .err; }
        }
    }
    else if const typesEq[T, DbValue] {
        match ref val {
            .some(x) { dst.* = (&x).*; }
            _ { return .err; }
        }
    }
    else if const typesEq[T, Maybe[DbValue]] {
        dst.* = (&val).*;
    }
    else {
        unsupportedType();
    }
    
    return .ok;
}

// Given list is left with length = 0
// Unless an exception is thrown, in which case it is unmodified
fn extractRow [T] (ref row: List[Maybe[DbValue]]): T unsafe {
    var result: T = uninitialised;

    // TODO type inference for builtin const function args
    if const (typeInfo[T] == TypeMeta.struct_ or typeInfo[T] == TypeMeta.tuple) and !typesEq[T, String] {
        if row.length() != fieldsCount[T] {
            leak[T](result);
            throw &"Query returned wrong number of fields";
        }

        for const (var i: ISize = 0; i < fieldsCount[T]; i += 1) {
            if _extractField[FieldType[T, i]](row.at(i), getFieldPtr[T, i](&result)) == .err {
                leak[T](result);
                throw &"Wrong type for field";
            }
        }
    }
    else {
        if row.length() != 1 {
            leak[T](result);
            throw &"Query returned wrong number of fields";
        }

        if _extractField[T](row.at(0), &result) == .err {
            leak[T](result);
            throw &"Wrong type for field";
        }
    }

    row.setLength(0);

    return result;
}
