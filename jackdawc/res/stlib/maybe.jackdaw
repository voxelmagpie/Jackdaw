enum Maybe [A] {
    some(A),
    none

    fn isSome (self: Self): Bool {
        match self {
            .some(_) { return true; }
            _ {}
        }
        return false;
    }

    fn orElse (var self: Self, var x: A): A {
        match self {
            .some(y) { return y; }
            _ {}
        }
        return x;
    }

    fn toResult [E] (var self: Self, var e: E): Result[A, E] {
        match self {
            .some(x) { return .ok(x); }
            _ { return .err(e); }
        }
    }

    fn orThrow (var self: Self): A {
        match self {
            .some(x) { return x; }
            _ { throw &"Maybe was None"; }
        }
    }

    fn orThrowMsg (var self: Self, msg: *const String): A {
        match self {
            .some(x) { return x; }
            _ { throw msg; }
        }
    }
}
