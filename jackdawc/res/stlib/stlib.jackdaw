const uncheckedArithmetic: Bool

//
// Compile-time reflection
//


// This constant is special as it compiles down to the sizeof operator in C
// This means it cannot be constant folded as the type checker does not know the value
const sizeOf [T]: I32

// This does not include auto-generated functions such as eq, hash, etc. unless they are implemented manually
const hasMember [T, name]: Bool

const typeName [T]: String

// Tuple and array elements count as fields and are named by their index
const getFields [A]: List[String]
const fieldsCount [A]: I32
alias FieldType [A, f] // TODO Take string as well as index
@NoThrow accessor getField [A, f] (A): FieldType[A, f] // TODO Take string as well as index
@Unsafe @NoThrow fn getFieldPtr [A, f] (*A): *FieldType[A, f] 
const typeIsCopyable [A]: Bool

const parameterCount[f]: I32

const enumDataConsCount [A]: I32 // 0 for unions
const dataConsTakesType [A, i]: Bool
alias DataConsType [A, i] // Not valid for data constructors that do not take a value
@NoThrow fn getEnumActiveIndex [A] (A): I32
@NoThrow fn setEnumActiveIndexUnsafe [A] (ref A, i: I32)
@NoThrow accessor getEnumIndexUnsafe [A, i] (A): DataConsType[A, i]
@Unsafe @NoThrow fn getEnumIndexPtrUnsafe [A, i] (*A): *DataConsType[A, i]

const isArrayType [A]: Bool
alias ArrayElemType [A]
const arrayLength [A]: I32
const typesEq [A, B]: Bool

// Gives field names, tuple/array lengths, parameter count
enum TypeMeta {
    struct_(List[String]),
    enum_(List[String]),
    tuple(I32),
    fn_(I32),
    ptr,
    array(I32),
    number,
    boolType
}

