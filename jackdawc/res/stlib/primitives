#define f(t) \
	fn add + 	(x: Self, y: Self): Self { return _add##t(x, y); } _NL \
	fn sub - 	(x: Self, y: Self): Self { return _sub##t(x, y); } _NL \
	fn mul * 	(x: Self, y: Self): Self { return _mul##t(x, y); } _NL \
	fn div / 	(x: Self, y: Self): Self { return _div##t(x, y); } _NL \
	fn eq  ==  	(x: Self, y: Self): Bool { return _eq##t(x, y); } _NL \
	fn neq != 	(x: Self, y: Self): Bool { return _neq##t(x, y); } _NL \
	fn gt  >  	(x: Self, y: Self): Bool { return _gt##t(x, y); } _NL \
	fn gte >= 	(x: Self, y: Self): Bool { return _gte##t(x, y); } _NL \
	fn lt  <  	(x: Self, y: Self): Bool { return _lt##t(x, y); } _NL \
	fn lte <= 	(x: Self, y: Self): Bool { return _lte##t(x, y); } _NL \
	fn neg - 	(x: Self): Self { return _neg##t(x); } _NL \
	fn addToHash (self: Self, ref h: Hash) unsafe { addHashBytes(h, RawSlice[U8]{ ptr = &self as *U8, length = sizeOf[Self] }); }


type F32 {
	f(_f32)

	fn rem % (x: Self, y: Self): Self { return remainderf(x, y); }
	fn addToString (x: Self, ref s: String) unsafe { floatAddToString[Self, snprintf_f32](x, s); }
	fn sqrt (x: Self): Self { return sqrtf(x); }
}

type F64 {
	f(_f64)

	fn rem % (x: Self, y: Self): Self { return remainder(x, y); }
	fn addToString (x: Self, ref s: String) unsafe { floatAddToString[Self, snprintf_f64](x, s); }
	fn sqrt (x: Self): Self { return sqrt(x); }
}

@NoThrow fn remainderf (F32, F32): F32
@NoThrow fn remainder (F64, F64): F64

@NoThrow fn sqrtf(F32): F32
@NoThrow fn sqrt (F64): F64

#undef f

type Bool {
	fn not  !  (x: Self): Self { return _not_bool(x); }
	fn not_ ~  (x: Self): Self { return _not_bool(x); }
	fn eq   == (x: Self, y: Self): Bool { return _eq_bool(x, y); }
	fn neq  != (x: Self, y: Self): Bool { return _neq_bool(x, y); }

	fn and_ & (x: Self, y: Self): Bool { return _and_bool(x, y); }
	fn or_  | (x: Self, y: Self): Bool { return _or_bool(x, y); }
	fn xor  ~ (x: Self, y: Self): Bool { return _neq_bool(x, y); }
	fn mul  * (x: Self, y: Self): Bool { return _and_bool(x, y); }
	fn add  + (x: Self, y: Self): Bool { return _or_bool(x, y); }

	fn addToString (self: Self, ref s: String) { 
		if self {
			s ++= "true";
		}
		else {
			s ++= "false";
		}
	}

	fn addToHash (self: Self, ref h: Hash) unsafe { 
		var x: U8 = self ? 1 : 0;
		addHashBytes(h, RawSlice[U8]{ ptr = &x, length = 1 }); 
	}

    fn isTruthy (self: Self): Bool {
        return self;
    }
}

#define g(t, name, op) \
	fn name op (x: Self, y: Self): Self { if const uncheckedArithmetic { return _##name##t(x, y); } else { return _checked_##name##t(x, y); } } _NL

#define f(t) \
	g(t, add, +) \
	g(t, sub, -) \
	g(t, mul, *) \
	g(t, div, /) \
	g(t, rem, %) \
	fn lsh  << (x: Self, y: I32): Self { return _lsh##t(x, y); } _NL \
	fn rsh  >> (x: Self, y: I32): Self { return _rsh##t(x, y); } _NL \
	fn bAnd & (x: Self, y: Self): Self { return _and##t(x, y); } _NL \
	fn bOr  | (x: Self, y: Self): Self { return _or##t(x, y); } _NL \
	fn xor  ~ (x: Self, y: Self): Self { return _xor##t(x, y); } _NL \
	fn eq   ==  (x: Self, y: Self): Bool { return _eq##t(x, y); } _NL \
	fn neq  != (x: Self, y: Self): Bool { return _neq##t(x, y); } _NL \
	fn gt   >  (x: Self, y: Self): Bool { return _gt##t(x, y); } _NL \
	fn gte  >= (x: Self, y: Self): Bool { return _gte##t(x, y); } _NL \
	fn lt   <  (x: Self, y: Self): Bool { return _lt##t(x, y); } _NL \
	fn lte  <= (x: Self, y: Self): Bool { return _lte##t(x, y); } _NL \
	fn wrappingAdd +% (x: Self, y: Self): Self { return _wadd##t(x, y); } _NL \
	fn wrappingSub -% (x: Self, y: Self): Self { return _wsub##t(x, y); } _NL \
	fn not ~ (x: Self): Self { return _not##t(x); } _NL \
	fn safeDiv (x: Self, y: Self): Maybe[Self] { if (y == 0) { return .none; } return .some(_div##t(x, y)); } _NL \
	fn safeRem (x: Self, y: Self): Maybe[Self] { if (y == 0) { return .none; } return .some(_rem##t(x, y)); } _NL \
	fn addToString (x: Self, ref s: String) { intAddToString[Self](x, s); } _NL \
	fn addToHash (self: Self, ref h: Hash) unsafe { addHashBytes(h, RawSlice[U8]{ ptr = &self as *U8, length = sizeOf[Self] }); }

#define ineg(t) \
	fn neg - (x: Self): Self { if const uncheckedArithmetic { return _neg##t(x); } else { return _checked_neg##t(x); } }

#define u_fns(t) \
	fn neg - (x: Self): Self { return _neg##t(x); } _NL \
	fn wrappingMul *% (x: Self, y: Self): Self { return _wmul##t(x, y); }

