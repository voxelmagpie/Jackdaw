//! 2 # 3\n9\n3\n3

fn start () {
    var a = readI32();

    var x = a;
    writeI32(f(x));

    writeI32(f(8));

    var x = X{a};
    var y = g(x);
    writeI32(y.a);

    writeI32(g(X{a}).a);
}

fn f (var x: I32): I32 {
    x = x + 1;
    return x;
}

struct X {
    a: I32

    fn onDrop (Self) {}
}

fn g (var x: X): X {
    x.a = x.a + 1;
    return x;
}
