//! # 3\n0

fn start (args: Args, var streams: IoStreams) unsafe {
	match f() {
		.ok {}
		.err(e) { writeI32(e); }
	}
	match f2() {
		.ok {}
		.err { writeI32(0); }
	}
}


fn f (): MaybeError[I32] {
	var x = g()!;
	return .ok;
}

fn g (): Result[I32, I32] {
	return .err(3);
}


fn f2 (): IsError {
	var x = g2()!;
	return .ok;
}

fn g2 (): Maybe[I32] {
	return .none;
}
