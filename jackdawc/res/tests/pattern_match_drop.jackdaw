//! -4 6 # 7

fn start () {
    var x: X = readI32() > 0 ? .a : .b(.{ a = readI32() });
    match var x {
        .a {}
        .b(y) {
            var {a} = y;
            writeI32(a+1);
        }
    }
}


enum X {
    a,
    b(Y)
}

struct Y {
    a: I32

    fn onDrop (ref self: Self) {
        writeI32(self.a);
    }
}