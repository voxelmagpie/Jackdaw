import "io"
import "posix" as Posix

enum ForkResult {
    // This is the original parent process
    // The Process value hold the pid of the child
    parent(Process),

    // This is the child process
    child
}

struct Process {
    @Unsafe
    pid: I32

    fn fork (): ForkResult unsafe {
        var x = Posix.fork();
        if x == -1 {
            ioError("fork");
        }
        else if x == 0 {
            return .child;
        }
        else {
            return .parent(Self{ pid=x });
        }
    }

    fn join (var self: Self) unsafe {
        if Posix.waitpid(self.pid, nullptr, 0) == -1 { trace("waitpid returned -1"); }
    }

    fn cancel (var self: Self) unsafe {
        Posix.kill(self.pid, sigTerm);
    }

    fn kill (var self: Self) unsafe {
        Posix.kill(self.pid, sigKill);
    }

    fn onDrop (ref Self) {}
}
