import "@stlib/raw_slice"
import "@stlib/range"

struct List [A] {
    // Do not reorder these fields, the compiler relies on the order when generating/using const lists

    @Unsafe
    ptr: *A, // = nullptr

    @Unsafe
    _length: ISize, // = 0

    // Capacity is 0 for const lists
    // Capacity may be non-zero for empty lists if it had data which was then removed
    @Unsafe
    capacity: ISize // = 0


    fn new (): Self unsafe {
        return Self{ ptr=nullptr, _length=0, capacity=0 };
    }

    fn singleton (var x: A): Self unsafe {
        var ptr = memAlloc(sizeOf[A]) as *A;
        ptr.* = x;
        return Self{ ptr=ptr, _length=1, capacity=1 };
    }

    fn length (self: Self): ISize unsafe {
        return self._length;
    }

    @Unsafe
	fn asRawSlice (self: Self): RawSlice[A] {
		return RawSlice[A]{ ptr = self.ptr, length=self._length };
	}

	accessor asSlice (self: Self): Slice[A] unsafe {
		return self.asRawSlice();
	}
    
    accessor at (self: Self, i: ISize): A unsafe { 
        assert(i >= 0 and i < self._length);
        return self.ptr.(i); 
    }

    accessor iterator iter (self: Self): A unsafe {
        foreach i in range[ISize](0, self._length) {
            yield self.ptr.(i);
        }
    }

    accessor iterator iterRange (self: Self, var start: ISize, var n: ISize): A unsafe {
        putRangeInBounds(self._length, start, n);
        foreach i in range[ISize](start, start+n) {
            yield self.ptr.(i);
        }
    }

    fn clear (ref self: Self) unsafe {
        foreach ref x in self.iter() {
            drop[A](x);
        }
        self._length = 0;
    }

    fn reserve (ref self: Self, minCap: ISize) unsafe {
        if minCap <= self.capacity { return; }
        var newCap = max[ISize](self.capacity + (self.capacity / 2), minCap);
        if newCap <= self.capacity { return; }

        self.ptr = memRealloc(self.ptr, newCap * sizeOf[A]) as *A;
        self.capacity = newCap;
    }

    fn pop (ref self: Self): A unsafe {
        if self._length < 1 { throw &"List is empty"; }
        self._length -= 1;
        return self.ptr.(self._length);
    }
    
    fn push (ref self: Self, var x: A) unsafe {
        self.reserve(self._length + 1);
        self.ptr.(self._length) = x;
        self._length += 1;
    }
    
    fn takeAt (ref self: Self, i: ISize): A unsafe {
        if i < 0 or i >= self._length { throw &"Index out of bounds"; }

        var x = self.ptr.(i);

        memCopy(self.ptr + i, self.ptr + i + 1, (self._length - i - 1) * sizeOf[A]);
        self._length -= 1;

        return x;
    }
    
    // Changes ordering of list elements
    fn takeBySwapAt (ref self: Self, i: ISize): A unsafe {
        if i < 0 or i >= self._length { throw &"Index out of bounds"; }

        var x = self.ptr.(i);

        self._length -= 1;
        self.ptr.(i) = self.ptr.(self._length);

        return x;
    }

    fn removeRangeAt (ref self: Self, var i: ISize, var n: ISize) unsafe {
        putRangeInBounds(self._length, i, n);
        if n == 0 { return; }

        for (var j: ISize = 0; j < n; j += 1) {
            drop[A](self.ptr.(i+j));
        }

        memCopy(self.ptr.(i), self.ptr.(i+n), self._length - i - n);
        self._length -= n;
    }

    fn removeRangeBySwapAt (ref self: Self, var i: ISize, var n: ISize) unsafe {
        putRangeInBounds(self._length, i, n);
        if n == 0 { return; }

        for (var j: ISize = 0; j < n; j += 1) {
            drop[A](self.ptr.(i+j));
        }

        var n_ = min[ISize](n, self.length - i - n);
        memCopyUnaliased(self.ptr.(i), self.ptr.(self._length - n_), n_);
        self._length -= n;
    }

    fn removeLastN (ref self: Self, n: ISize) {
        foreach _ in range[ISize](0, n) {
            _ = self.pop();
        }
    }
    
    fn insertAt (ref self: Self, var i: ISize, var x: A) unsafe {
        i = i > self._length ? self._length : i >= 0 ? i : 0;

        var newLength = self._length + 1;
        self.reserve(newLength);
        memCopy(self.ptr + i + 1, self.ptr + i, (self._length - i) * sizeOf[A]);
        self.ptr.(i) = x;
        self._length = newLength;
    }

    fn insertListAt (ref self: Self, i: ISize, var xs: Self) unsafe {
        self.copyRawSliceAt(i, xs.asRawSlice());
        memFree(xs.ptr);
        leak[Self](xs); // Don't drop as data has been copied
    }

    @Unsafe
    fn copyRawSliceAt (ref self: Self, i: ISize, xs: RawSlice[A]) {
        var newLength = self._length + xs.length;
        self.reserve(newLength);
        var i = clamp[ISize](i, 0, self._length);

        memCopy(self.ptr + i + xs.length, self.ptr + i, (self._length - i) * sizeOf[A]);
        memCopy(self.ptr + i, xs.ptr, xs.length * sizeOf[A]);
        
        self._length = newLength;
    }

    fn insertSliceAt (ref self: Self, i: ISize, xs: Slice[A]) unsafe {
        var newLength = self._length + xs.length();
        self.reserve(newLength);
        var i = clamp[ISize](i, 0, self._length);

        memCopy(self.ptr + i + xs.length(), self.ptr + i, (self._length - i) * sizeOf[A]);

        if const typeIsCopyable[A] {
            memCopyUnaliased(self.ptr + i, xs.asRawSlice().ptr, xs.length() * sizeOf[A]);
        }
        else {
            for (var j: ISize = 0; j < xs.length(); j += 1) {
                self.ptr(i+j) = xs.at(j).clone();
            }
        }
        self._length = newLength;
    }

    fn ++ join (self: Self, xs: Slice[A]) {
        var l = List[A].new();
        l.reserve(self.length() + xs.length());
        foreach x in self.iter() { l.push(x.clone()); }
        foreach x in xs.iter() { l.push(x.clone()); }
        return l;
    }

    fn ++= append (ref self: Self, xs: Slice[A]) unsafe {
        self.insertSliceAt(self._length, xs);
    }

    fn appendList (ref self: Self, var xs: List[A]) unsafe {
        self.copyRawSliceAt(self._length, xs.asRawSlice());
        memFree(xs.ptr);
        leak[Self](xs); // Don't drop as data has been copied
    }

    fn clone (self: Self): Self unsafe {
        var p = memAlloc(self._length * sizeOf[A]) as *A;
        if const typeIsCopyable[A] {
            memCopyUnaliased(p, self.ptr, self._length * sizeOf[A]);
        }
        else {
            for (var i: ISize = 0; i < self._length; i += 1) {
                p.(i) = self.at(i).clone();
            }
        }
        
        return Self{ ptr=p, _length=self._length, capacity=self._length };
    }

    fn == eq (self: Self, other: Self): Bool {
        if self.length() != other.length() { return false; }
        for (var i: ISize = 0; i < self.length(); i += 1) {
            if self.at(i) != other.at(i) { return false; }
        }
        return true;
    }

    fn onDrop (ref self: Self) unsafe {
        for (var i: ISize = 0; i < self._length; i += 1) {
            drop[A](self.ptr.(i));
        }
        memFree(self.ptr);
        self.ptr = nullptr;
        self._length = 0;
        self.capacity = 0;
    }

}
