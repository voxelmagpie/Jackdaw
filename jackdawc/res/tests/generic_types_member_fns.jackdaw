//! 1 3 # 0\n2.00
//! 2 -3 # 1\n3.00

struct X [A] {
    a: A,
    b: Bool


    fn isTrue (self: Self): Bool {
        return self.b;
    }

    fn f [B] (self: Self, x: B, add: fn (A, B): B): B {
        return add(self.a, x);
    }
}

fn addI32F64 (a: I32, b: F64): F64 {
    return a as F64 + b;
}

fn start () {
    var x = X[I32]{a = readI32(), b = readI32() > 0 ? true : false};
    writeI32(!x.isTrue() ? 1 : 0);

    writeF64(x.f[F64](1.0, addI32F64));
}