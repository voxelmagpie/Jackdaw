import "@stlib/memory"

struct RingBuffer [A] {
    @Unsafe ptr: *A,
    @Unsafe capacity: ISize,
    @Unsafe start: ISize,
    @Unsafe _count: ISize

    fn new (var capacity: ISize): Self unsafe {
        if capacity < 0 { capacity = 0; }
        return Self {
            ptr = capacity == 0 ? nullptr : alloc[A](capacity),
            capacity,
            start=0,
            _count=0
        };
    }

    fn count (self: Self): ISize unsafe {
        return self._count;
    }

    fn spaceRemaining (self: Self): ISize unsafe {
        return self.capacity - self._count;
    }

    fn isFull (self: Self): Bool unsafe {
        return self._count >= self.capacity;
    }

    fn isEmpty (self: Self): Bool unsafe {
        return self._count < 1;
    }

    fn push (ref self: Self, var x: A) unsafe {
        if self.isFull() { throw &"Ring buffer is full"; }
        var i = (self.start + self._count) % self.capacity;
        self.ptr.(i) = x;
        self._count += 1;
    }

    fn pop (ref self: Self): A unsafe {
        if self.isEmpty() { throw &"Ring buffer is empty"; }
        var x = self.ptr.(self.start);
        self.start = (self.start + 1) % self.capacity;
        self._count -= 1;
        return x;
    }

    fn peek (ref self: Self): A unsafe {
        if self.isEmpty() { throw &"Ring buffer is empty"; }
        return self.ptr.(self.start);
    }

    fn onDrop (ref self: Self) unsafe {
        if self.ptr != nullptr {
            free(self.ptr);
            self.ptr = nullptr;
        }
    }

    // TODO insert/remove functions to match list
}
